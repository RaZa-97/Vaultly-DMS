# Vaultly / Paperless-ngx deployment template
# Copy this file to .env on the Ubuntu VM and replace every placeholder.
# Never commit the real .env file.

# Stable Docker Compose project name. This prefixes the Docker volume names.
COMPOSE_PROJECT_NAME=vaultly

# Host port used to open Vaultly at http://VM_IP:8000.
PAPERLESS_PORT=8000

# Match files created by Paperless to the Ubuntu user's UID and GID.
USERMAP_UID=replace-with-output-of-id-u
USERMAP_GID=replace-with-output-of-id-g

# PostgreSQL connection details. Keep the database name and user simple; replace
# the password with a separate strong random value on the VM.
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=replace-with-a-strong-random-database-password

# Authentication secret and initial administrator account.
PAPERLESS_SECRET_KEY=replace-with-a-long-random-secret
PAPERLESS_ADMIN_USER=replace-with-admin-username
PAPERLESS_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Vaultly frontend branding. docker-compose.yml mounts the repository assets
# read-only into Paperless's served static root.
PAPERLESS_APP_TITLE=Vaultly
PAPERLESS_APP_LOGO=/static/vaultly-logo.svg

# Paperless settings. Use an IANA timezone and a three-letter Tesseract language
# code, for example Asia/Colombo and eng.
PAPERLESS_TIME_ZONE=replace-with-iana-timezone
PAPERLESS_OCR_LANGUAGE=replace-with-three-letter-ocr-language-code

# Optional: leave empty for English, German, Italian, Spanish, or French. For
# other OCR languages, list the additional package code(s), separated by spaces.
PAPERLESS_OCR_LANGUAGES=
