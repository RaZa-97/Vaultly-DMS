# Vaultly / Paperless-ngx deployment template
# Copy this file to .env on the Ubuntu VM and replace every placeholder.
# Never commit the real .env file.

PAPERLESS_SECRET_KEY=replace-with-a-long-random-secret
PAPERLESS_ADMIN_USER=replace-with-admin-username
PAPERLESS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PAPERLESS_TIME_ZONE=replace-with-timezone
PAPERLESS_OCR_LANGUAGE=replace-with-ocr-language-code
PAPERLESS_PORT=8000
USERMAP_UID=replace-with-output-of-id-u
USERMAP_GID=replace-with-output-of-id-g
