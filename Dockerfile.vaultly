# syntax=docker/dockerfile:1

# Build against the exact Paperless-ngx source revision used by the runtime.
FROM docker.io/alpine:3.22.2 AS source

RUN apk add --no-cache git

ARG PAPERLESS_TAG=v2.20.15
ARG PAPERLESS_COMMIT=05e48b23166df7c7afe6f329b460b0511a89496c

RUN git clone --depth 1 --branch "${PAPERLESS_TAG}" \
      https://github.com/paperless-ngx/paperless-ngx.git /source \
    && test "$(git -C /source rev-parse HEAD)" = "${PAPERLESS_COMMIT}"

COPY custom-frontend/vaultly-2.20.15.patch /tmp/vaultly.patch
RUN git -C /source apply --check /tmp/vaultly.patch \
    && git -C /source apply /tmp/vaultly.patch

COPY branding/vaultly-favicon.svg /source/src-ui/src/vaultly-favicon.svg
COPY branding/vaultly-favicon.svg /source/src/paperless/static/paperless/img/vaultly-favicon.svg

FROM docker.io/node:20-trixie-slim AS frontend

COPY --from=source /source/src-ui /src/src-ui
COPY --from=source /source/src /src/src

WORKDIR /src/src-ui
RUN corepack enable \
    && corepack prepare pnpm@10.17.1 --activate \
    && pnpm install --frozen-lockfile \
    && ./node_modules/.bin/ng build --configuration production

# Retain the complete official runtime and replace only its browser frontend.
FROM ghcr.io/paperless-ngx/paperless-ngx:2.20.15

COPY --from=frontend --chown=paperless:paperless \
  /src/src/documents/static/frontend/ \
  /usr/src/paperless/src/documents/static/frontend/
# The whole template tree, not individual files: the Vaultly naming touches
# the login, signup, password-reset, MFA, social-account and account-inactive
# pages plus the transactional email body. Copying the directory keeps one
# of them from being missed.
COPY --from=source --chown=paperless:paperless \
  /source/src/documents/templates/ \
  /usr/src/paperless/src/documents/templates/
COPY --from=source --chown=paperless:paperless \
  /source/src/paperless/views.py \
  /usr/src/paperless/src/paperless/views.py
COPY --from=source --chown=paperless:paperless \
  /source/src/paperless/urls.py \
  /usr/src/paperless/src/paperless/urls.py
# Backend product naming: the upload-source form label, and the API schema
# title and endpoint descriptions.
COPY --from=source --chown=paperless:paperless \
  /source/src/paperless/settings.py \
  /usr/src/paperless/src/paperless/settings.py
COPY --from=source --chown=paperless:paperless \
  /source/src/documents/serialisers.py \
  /usr/src/paperless/src/documents/serialisers.py
COPY --from=source --chown=paperless:paperless \
  /source/src/documents/views.py \
  /usr/src/paperless/src/documents/views.py
COPY --from=source --chown=paperless:paperless \
  /source/src/paperless/static/paperless/img/vaultly-favicon.svg \
  /usr/src/paperless/src/paperless/static/paperless/img/vaultly-favicon.svg
COPY --from=source --chown=paperless:paperless \
  /source/src/documents/static/base.css \
  /usr/src/paperless/src/documents/static/base.css
COPY --chown=paperless:paperless \
  vaultly-docs/ \
  /usr/src/paperless/src/documents/static/vaultly-docs/

RUN cd /usr/src/paperless/src \
    && s6-setuidgid paperless python3 manage.py collectstatic --clear --no-input --link
